{
  "rewrites": [
    { "source": "/",        "destination": "/prototype/index.html" },
    { "source": "/:path+",  "destination": "/prototype/:path+",
      "missing": [{ "type": "header", "key": "x-matched-path" }] }
  ],
  "crons": [
    {
      "path": "/api/send-reminders",
      "schedule": "0 * * * *"
    }
  ]
}
